# ---------------------------------------------------------------------
#  Arch Agent - environment template
#  Copy to `.env` and replace the example values with real credentials:
#      cp env.example .env
#  `.env` is gitignored. Never commit real keys.
# ---------------------------------------------------------------------

# --- Server-side only (never exposed to the browser) -----------------

# Google Gemini - powers chat, project titles, prompt enhancement and cost
# estimation. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSyEXAMPLE-replace-with-your-real-gemini-key

# Optional: override the chat model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# Hugging Face - primary image provider (FLUX.1-schnell) and 3D mesh
# synthesis (TRELLIS). Get one at https://huggingface.co/settings/tokens
# Without it, images fall back to the keyless Pollinations provider and
# 3D synthesis is disabled.
HUGGINGFACE_API_KEY=hf_EXAMPLE_replace_with_your_real_token

# Port the Express server listens on.
PORT=3000

# --- Client-side (bundled into the browser build - anon keys only) ---

# Supabase project URL and ANON key. The anon key is safe to expose only
# while Row Level Security is enabled on your tables.
# Leave blank to run in local-only mode (sessions persist to localStorage).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.EXAMPLE.replace-with-your-anon-key
